# Figma personal access token with file read access (required for figma_spec / sync_tokens).
# Create at: Figma → Settings → Security → Personal access tokens.
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How the HubSpot CLI is invoked (used by verify_upload). Defaults shown.
# The fetch subcommand form has drifted across CLI versions — adjust if needed.
SPECSYNC_HS_CMD=npx hs
SPECSYNC_HS_FETCH=cms fetch

# Optional: cap on nodes returned by a single figma_spec walk (protects agent context).
SPECSYNC_MAX_NODES=400
